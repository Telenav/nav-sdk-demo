<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/search_overlay_surface"
    android:clickable="true"
    android:elevation="6dp"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/dimens_10dp"
        android:paddingTop="@dimen/dimens_10dp"
        android:paddingEnd="@dimen/dimens_10dp"
        android:paddingBottom="@dimen/dimens_5dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingEnd="36dp">

            <ImageView
                android:id="@+id/detailProviderIcon"
                android:layout_width="22dp"
                android:layout_height="32dp"
                android:layout_alignParentStart="true"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_tn_place_pin" />

            <TextView
                android:id="@+id/detailName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dimens_10dp"
                android:layout_toEndOf="@id/detailProviderIcon"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/search_overlay_text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="Manner Coffee" />
        </RelativeLayout>

        <LinearLayout
            android:id="@+id/detailRatingRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/detailRatingScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/search_overlay_text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="5.0" />

            <TextView
                android:id="@+id/detailRatingStars"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:letterSpacing="0.05"
                android:textSize="14sp"
                tools:text="★★★★★" />

            <TextView
                android:id="@+id/detailRatingCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textColor="@color/search_overlay_text_secondary"
                android:textSize="13sp"
                tools:text="(128)" />
        </LinearLayout>

        <TextView
            android:id="@+id/detailCategoryLine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/search_overlay_text_secondary"
            android:textSize="13sp"
            android:visibility="gone"
            tools:text="Wholesaler · $$"
            tools:visibility="visible" />

        <LinearLayout
            android:id="@+id/detailOpenHoursRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/detailOpenStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="Open"
                tools:textColor="@color/search_detail_open"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/detailClosingTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:textColor="@color/search_overlay_text_secondary"
                android:textSize="13sp"
                android:visibility="gone"
                tools:text="· Closes 8:30 PM"
                tools:visibility="visible" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/detailEvConnectorsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible" />

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/detailTabLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@android:color/transparent"
            app:tabGravity="fill"
            app:tabIndicatorColor="@color/colorPrimary"
            app:tabIndicatorFullWidth="false"
            app:tabMode="fixed"
            app:tabSelectedTextColor="@color/search_overlay_text_primary"
            app:tabTextAppearance="@style/SearchDetailTabText"
            app:tabTextColor="@color/search_overlay_text_hint" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/search_overlay_divider" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/detailOverviewPanel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:fillViewport="true"
                android:paddingBottom="@dimen/dimens_10dp"
                android:scrollbars="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/detailPhotoRecyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:clipToPadding="false"
                        android:nestedScrollingEnabled="false"
                        android:orientation="horizontal"
                        android:visibility="gone"
                        tools:itemCount="3"
                        tools:listitem="@layout/detail_photo_item"
                        tools:visibility="visible" />

                    <LinearLayout
                        android:id="@+id/detailOverviewInfoContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/detailDestinationReachedMessage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:gravity="center"
                        android:text="@string/search_detail_destination_reached"
                        android:textColor="@color/search_overlay_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/detailNavigateButton"
                        style="@style/Widget.MaterialComponents.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="@string/start_navigation"
                        app:cornerRadius="8dp" />
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

            <androidx.core.widget.NestedScrollView
                android:id="@+id/detailReviewsPanel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:fillViewport="true"
                android:paddingTop="8dp"
                android:paddingBottom="@dimen/dimens_10dp"
                android:scrollbars="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/detailReviewsEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:gravity="center"
                        android:text="@string/search_detail_no_reviews"
                        android:textColor="@color/search_overlay_text_hint"
                        android:textSize="14sp"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/detailReviewsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

            <ProgressBar
                android:id="@+id/detailLoadingBar"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone"
                tools:visibility="visible" />
        </FrameLayout>
    </LinearLayout>

    <ImageButton
        android:id="@+id/detailCloseButton"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/search_detail_close"
        android:padding="6dp"
        android:scaleType="centerInside"
        android:src="@android:drawable/ic_menu_close_clear_cancel" />
</FrameLayout>
