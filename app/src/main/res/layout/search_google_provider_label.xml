<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/dimens_10dp"
    android:paddingTop="@dimen/dimens_5dp"
    android:paddingEnd="@dimen/dimens_10dp"
    android:paddingBottom="@dimen/dimens_10dp"
    android:visibility="gone"
    tools:visibility="visible">

    <ImageView
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_google_maps_pin" />

    <TextView
        android:id="@+id/googleProviderLabelText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:text="@string/search_results_from_google"
        android:textColor="@color/search_google_results_label"
        android:textSize="13sp"
        android:textStyle="bold" />

</LinearLayout>
